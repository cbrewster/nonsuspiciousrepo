#!/usr/bin/env bash
set -euxo pipefail

# ---- idempotency guard -------------------------------------------------
if [[ -f did_build ]]; then
  echo "did_build present; nothing to do."
  exit 0
fi

export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# ---- non-interactive environment ---------------------------------------
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a          # Ubuntu 22.04+ needrestart prompts otherwise
export NEEDRESTART_SUSPEND=1
export CLOUDSDK_CORE_DISABLE_PROMPTS=1

: "${HOME:=/root}"
export CLOUDSDK_CONFIG="${CLOUDSDK_CONFIG:-$HOME/.config/gcloud}"

# gpg gets its own throwaway homedir so it never touches ~/.gnupg
GNUPGHOME="$(mktemp -d)"
export GNUPGHOME
trap 'rm -rf "$GNUPGHOME"' EXIT

APT_OPTS=(-y -o Dpkg::Options::=--force-confold -o Dpkg::Options::=--force-confdef)

# ---- clear any half-written state from a previous failed run -------------
# The repo line must NOT be present during the bootstrap update below, or apt
# fails on NO_PUBKEY before we've had a chance to install the key.
rm -f /etc/apt/sources.list.d/google-cloud-sdk.list \
      /usr/share/keyrings/cloud.google.gpg

# ---- base packages ------------------------------------------------------
apt-get update
apt-get install "${APT_OPTS[@]}" ca-certificates gnupg curl

# ---- google apt repo ----------------------------------------------------
install -d -m 0755 /usr/share/keyrings
curl -fsSL --retry 5 --retry-connrefused --retry-delay 2 \
  https://packages.cloud.google.com/apt/doc/apt-key.gpg \
  | gpg --batch --yes --dearmor -o /usr/share/keyrings/cloud.google.gpg
chmod 0644 /usr/share/keyrings/cloud.google.gpg

# an empty/garbage keyring is what caused the NO_PUBKEY loop; fail loudly here
# instead of leaving a broken source behind.
[[ -s /usr/share/keyrings/cloud.google.gpg ]] || { echo "keyring is empty" >&2; exit 1; }
gpg --batch --no-default-keyring --keyring /usr/share/keyrings/cloud.google.gpg --list-keys >/dev/null

# '>' not 'tee -a' so re-runs don't duplicate the entry
install -d -m 0755 /etc/apt/sources.list.d
cat > /etc/apt/sources.list.d/google-cloud-sdk.list <<'EOF'
deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main
EOF

apt-get update
apt-get install "${APT_OPTS[@]}" google-cloud-cli

# ---- workload identity federation ---------------------------------------
WIF_PROVIDER=projects/393725241020/locations/global/workloadIdentityPools/repl-identity/providers/repl-rp-replit-usc1
IDENTITY_URL="http://127.0.0.1:1106/identityv2/gcloud/token"

mkdir -p "$CLOUDSDK_CONFIG"

gcloud iam workload-identity-pools create-cred-config "$WIF_PROVIDER" \
  --quiet \
  --service-account="zergrush-zergling-dev@replit-goval-dev.iam.gserviceaccount.com" \
  --credential-source-url="$IDENTITY_URL" \
  --credential-source-headers="X-Replit-Identity-Audience=//iam.googleapis.com/$WIF_PROVIDER" \
  --credential-source-type="json" \
  --credential-source-field-name="id_token" \
  --output-file="$CLOUDSDK_CONFIG/wif-profile.json"

# Wait for the local identity server to start listening. This checks TCP only:
# an HTTP error still means the server is up, so it must not count as "down".
for i in {1..30}; do
  timeout 2 bash -c ': < /dev/tcp/127.0.0.1/1106' 2>/dev/null && break
  [[ $i -eq 30 ]] && { echo "nothing listening on 127.0.0.1:1106" >&2; exit 1; }
  sleep 2
done

# Confirm it will actually mint a token, and surface the error body if not.
# NOTE: curl wants "Name: Value"; gcloud's --credential-source-headers wants
# "Name=Value". Using '=' here sends a header with no colon, which is malformed
# HTTP and gets you a bare 400 from the server.
probe_out="$(mktemp)"
http_code="$(curl -sS -o "$probe_out" -w '%{http_code}' --max-time 10 \
  -H "X-Replit-Identity-Audience: //iam.googleapis.com/$WIF_PROVIDER" \
  "$IDENTITY_URL")" || http_code=000
if [[ "$http_code" != 200 ]]; then
  echo "identity endpoint returned HTTP $http_code:" >&2
  head -c 500 "$probe_out" >&2; echo >&2
  rm -f "$probe_out"
  exit 1
fi
rm -f "$probe_out"

gcloud auth login --quiet --cred-file="$CLOUDSDK_CONFIG/wif-profile.json"
gcloud auth list --quiet

touch did_build
